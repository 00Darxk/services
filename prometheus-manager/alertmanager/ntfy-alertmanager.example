http-address :8080
base-url http://__PROMETHEUS_BASE_URL__
log-level debug
alert-mode single
user __DEFAULT_NTFY_USERNAME__
password __DEFAULT_NTFY_PASSWORD__

labels {
    order "severity"

    severity "critical" {
        priority 4
    }

    severity "warning" {
        priority 3
    }

    severity "info" {
        priority 1
    }
}

resolved {
    tags "resolved"
}

ntfy {
    topic https://__NTFY_BASE_URL__/alertmanager
}

alertmanager {
    silence-duration 24h
    url http://localhost:9093
    user __DEFAULT_NTFY_USERNAME__
    password __DEFAULT_NTFY_PASSWORD__

}

cache {
    type redis
    duration 24h

    redis-url redis://localhost:6379/10
}
