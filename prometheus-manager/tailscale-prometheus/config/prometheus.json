{
  "TCP": {
    "443": {
      "HTTPS": true
    },
    "8080": {
      "HTTPS": true
    },
    "9090": {
      "HTTPS": true
    },
    "9093": {
      "HTTPS": true
    },
    "9100": {
      "HTTPS": true
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": {
          "Proxy": "http://localhost:9090"
        }
      }
    },
    "${TS_CERT_DOMAIN}:8080": {
      "Handlers": {
        "/": {
          "Proxy": "http://localhost:8080"
        }
      }
    },
    "${TS_CERT_DOMAIN}:9090": {
      "Handlers": {
        "/": {
          "Proxy": "http://localhost:9090"
        }
      }
    },
    "${TS_CERT_DOMAIN}:9093": {
      "Handlers": {
        "/": {
          "Proxy": "http://localhost:9093"
        }
      }
    },
    "${TS_CERT_DOMAIN}:9100": {
      "Handlers": {
        "/": {
          "Proxy": "http://localhost:9100"
        }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:443": false
  }
}
